# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real secrets.

# --- Groq (AI tutor, quiz generation, learning assistant) ---
# https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- MongoDB Atlas ---
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB=bearnet

# --- Auth ---
# Any long random string. Used to sign the session cookie.
AUTH_SECRET=generate-a-long-random-string-at-least-32-characters
